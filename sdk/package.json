{
  "name": "corsfix",
  "version": "2.1.0",
  "description": "Corsfix CORS proxy JavaScript client library",
  "main": "index.js",
  "type": "module",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.js"
    }
  },
  "unpkg": "corsfix.js",
  "jsdelivr": "corsfix.js",
  "files": [
    "index.js",
    "index.d.ts",
    "corsfix.js"
  ],
  "scripts": {
    "build": "esbuild browser.js --bundle --format=iife --outfile=corsfix.js",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "cors",
    "proxy",
    "fetch",
    "api"
  ],
  "author": "Corsfix",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vitest": "^3.2.4"
  }
}
