# HTTP to HTTPS redirects
http://{$APP_DOMAIN:app.localhost} {
    redir https://{host}:{$HTTPS_PORT:443}{uri} permanent
}

http://{$PROXY_DOMAIN:proxy.localhost} {
    redir https://{host}:{$HTTPS_PORT:443}{uri} permanent
}

# HTTPS
{$APP_DOMAIN:app.localhost} {
    # X-Real-IP is set from the connection, never taken from the client, so
    # per-IP rate limits can't be bypassed with a forged header.
    reverse_proxy app:3000 {
        header_up X-Real-IP {remote_host}
    }
    # tls /certs/cert.pem /certs/key.pem
}

{$PROXY_DOMAIN:proxy.localhost} {
    reverse_proxy proxy:80 {
        header_up X-Real-IP {remote_host}
    }
    # tls /certs/cert.pem /certs/key.pem
}
